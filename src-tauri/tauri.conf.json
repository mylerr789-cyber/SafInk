{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SafInk",
  "version": "0.4.0",
  "identifier": "com.safink.app",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SafInk",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#1b1b1d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGMDE2REFCMTM1OUVEODkKUldTSjdWa1RxMjBCengvazQ1S01HcWZlc3NJWExocDlQM2U0QVdWaExKbklRYlphWE5NN1lHMCsK",
      "endpoints": [
        "https://github.com/mylerr789-cyber/SafInk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
